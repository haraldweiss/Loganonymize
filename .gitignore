# macOS
.DS_Store

# Local development server (start.sh / stop.sh artefacts)
.server.pid
.server.log

# Claude Code working directory — local-only
.claude/

# Local SSL certs (start.sh auto-generates these)
*.pem
*.key

# Editor scratch
*.swp
*~
.idea/
.vscode/
.serena/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Local coding-agent approvals and transcripts can contain credentials.
**/.claude/settings.local.json
**/.claude/history.jsonl
**/.claude/projects/
**/.claude/transcripts/
.specstory/
.aider.chat.history.md
.aider.input.history

# Database backups may contain tokens and other private runtime data.
*.sqlite.bak*
*.sqlite3.bak*
*.db.bak*
